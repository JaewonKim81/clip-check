# ===== ClipCheck 환경변수 =====
# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 git에 올라가지 않습니다)

# OpenAI API 키 (필수) — 장면 분석 · 금칙 판정 · 자막 교정 · 검색 임베딩에 사용
OPENAI_API_KEY=

# 사용 모델 (선택 — 기본값 그대로 두어도 됨)
OPENAI_VISION_MODEL=gpt-5-mini
OPENAI_TEXT_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# 음성 인식 — 로컬 python whisper 라이브러리 사용 (pip install openai-whisper)
# 모델: tiny / base / small / medium / large-v3 (클수록 정확·느림)
PYTHON_BIN=python
WHISPER_MODEL=base
WHISPER_LANGUAGE=ko

# 텔레그램 알림 (선택) — 비워두면 알림 비활성화
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 서버 포트
PORT=3001
